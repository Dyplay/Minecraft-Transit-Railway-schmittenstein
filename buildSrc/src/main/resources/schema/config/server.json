{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"javaImplements": [
		"SerializedDataBase"
	],
	"properties": {
		"webserverPort": {
			"type": "integer",
			"default": 8888
		},
		"useThreadedSimulation": {
			"type": "boolean"
		},
		"useThreadedFileLoading": {
			"type": "boolean"
		},
		"forceShutDownStrayThreads": {
			"type": "boolean"
		},
		"baseFareCents": {
			"type": "integer",
			"default": 200
		},
		"zoneFareCents": {
			"type": "integer",
			"default": 100
		},
		"fareEvasionFineCents": {
			"type": "integer",
			"default": 50000
		}
	}
}
